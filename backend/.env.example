# Production shipping policy
# EasyPost is not required for checkout.
# Standard Shipping is charged from the destination and mug quantity.
# Defaults: $8.95 first mug + $2.50 each additional mug in the contiguous US.
# Alaska/Hawaii defaults: $14.95 first mug + $4.50 each additional mug.
SHIPPING_STANDARD_CENTS=895
SHIPPING_STANDARD_ADDITIONAL_MUG_CENTS=250
SHIPPING_STANDARD_AK_HI_CENTS=1495
SHIPPING_STANDARD_AK_HI_ADDITIONAL_MUG_CENTS=450

# Destination-based sales tax is calculated server-side through Stripe Tax.
