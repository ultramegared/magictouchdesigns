# Destination-based shipping (server-side only)
# Keep EASYPOST_API_KEY and the origin address private. Never expose them to the frontend.
EASYPOST_API_KEY=your_easypost_api_key
SHIPPING_ORIGIN_ADDRESS_JSON={"name":"JQYDesigns","street1":"YOUR_PRIVATE_ORIGIN_ADDRESS","city":"YOUR_CITY","state":"TX","zip":"YOUR_ZIP","country":"US"}

# Physical package profile used for live rating.
# Dimensions are inches; weight is ounces. Use real measured production packaging.
SHIPPING_PACKAGE_PROFILES_JSON=[{"length":10,"width":8,"height":6,"weight":16}]
