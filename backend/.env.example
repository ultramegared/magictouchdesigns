# Live USPS API (current OAuth 2.0 platform)
# USPS Web Tools was retired in January 2026. These credentials come from
# the USPS Developer Portal / Customer Onboarding Portal.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_ORIGIN_ZIP=
# Optional: Enterprise Payment System account for contract/commercial postage.
USPS_EPS_ACCOUNT_NUMBER=

# Final measured shipping package profiles.
# Defaults are conservative reference values for protective single-mug packages.
# Replace them with the actual measured JQYDesigns packed weights/dimensions.
USPS_11OZ_PACKAGE_WEIGHT_LB=1
USPS_11OZ_PACKAGE_LENGTH_IN=6
USPS_11OZ_PACKAGE_WIDTH_IN=5
USPS_11OZ_PACKAGE_HEIGHT_IN=5

USPS_15OZ_PACKAGE_WEIGHT_LB=1.25
USPS_15OZ_PACKAGE_LENGTH_IN=6
USPS_15OZ_PACKAGE_WIDTH_IN=6
USPS_15OZ_PACKAGE_HEIGHT_IN=5

# Destination-based sales tax is calculated server-side through Stripe Tax.

# JQYDesigns Marketing Center — social OAuth
# These values belong in the BACKEND/production environment only.
# Never expose the client secrets in the frontend or GitHub.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
FRONTEND_PUBLIC_URL=https://www.jqydesigns.com
BACKEND_PUBLIC_URL=https://api.jqydesigns.com
# OAuth callback URLs to register exactly in each provider:
# Meta:      https://api.jqydesigns.com/api/admin/marketing/social/meta/callback
# TikTok:    https://api.jqydesigns.com/api/admin/marketing/social/tiktok/callback
# Google:    https://api.jqydesigns.com/api/admin/marketing/social/youtube/callback
# Pinterest: https://api.jqydesigns.com/api/admin/marketing/social/pinterest/callback

# Vercel Cron protection
CRON_SECRET=

# Marketing — Google Ads (real verification only)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
