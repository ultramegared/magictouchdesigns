{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/marketing-learning",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/marketing/social/campaign/autopilot-run",
      "schedule": "0 * * * *"
    }
  ]
}
