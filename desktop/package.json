{
  "author": "JQYDesigns",
  "build": {
    "appId": "com.jqydesigns.marketing",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "build/icon.ico",
      "package.json",
      "!ui/fondo-*.b64"
    ],
    "nsis": {
      "createDesktopShortcut": true,
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "JQYDesigns Marketing"
    },
    "productName": "JQYDesigns Marketing",
    "publish": [
      {
        "owner": "ultramegared",
        "provider": "github",
        "repo": "magictouchdesigns"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "description": "JQYDesigns Marketing Brain para PC",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "jqydesigns-marketing",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --publish never",
    "start": "electron .",
    "predist": "node -e \"const fs=require('fs');const parts=['ui/fondo-1.b64','ui/fondo-2.b64','ui/fondo-3.b64','ui/fondo-4.b64'];const b=parts.map(f=>fs.readFileSync(f,'utf8')).join('').replace(/\\s/g,'');fs.writeFileSync('ui/fondo.webp',Buffer.from(b,'base64'));\""
  },
  "version": "1.1.5"
}